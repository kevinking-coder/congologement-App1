{
  "type": "fullstack-supabase",
  "paths": {
    "root": "mobile",
    "app": "app",
    "components": "components",
    "src": "src",
    "api": "api",
    "web": "web",
    "alias": {
      "@": "mobile"
    }
  },
  "workspaces": {
    "mobile": {
      "type": "expo",
      "root": "mobile"
    },
    "api": {
      "type": "express",
      "root": "api",
      "entry": "index.js"
    },
    "web": {
      "type": "static",
      "root": "web"
    },
    "database": {
      "type": "supabase",
      "root": "supabase",
      "migrations": "supabase/migrations"
    }
  },
  "dynamicRouteDefaults": {
    "listing/[id]": { "id": "l-1" },
    "seller/[sellerId]": { "sellerId": "00000000-0000-0000-0000-000000000001" }
  }
}
