{
  "expo": {
    "name": "Congo Logement",
    "slug": "congo-app",
    "owner": "brak.iddy",
    "version": "1.0.18",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "congologement",
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Autoriser Congo Logement à accéder à vos photos pour illustrer vos annonces.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.congologement.app"
    },
    "android": {
      "package": "com.congologement.app",
      "versionCode": 18,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#007FFF"
      }
    },
    "extra": {
      "eas": {
        "projectId": "e89b0d6a-e465-4ac9-96cd-c0dbff6f424e"
      }
    }
  }
}
